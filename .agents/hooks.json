{
  "cortex-observability": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python -m cortex_engine.antigravity_hook --event pre",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python -m cortex_engine.antigravity_hook --event post",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
